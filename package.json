{
  "name": "fullscreen-potente",
  "version": "1.0.0",
  "description": "Proyecto decoupled (Jamstack): tienda, panel de admin y paquetes compartidos separados.",
  "main": "server.js",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/store",
    "packages/admin"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ext js,html,css server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
